[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/minigame_feedback.gd" id="1_feedback"]

[node name="MinigameFeedback" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
