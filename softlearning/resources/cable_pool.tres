examples = Array[String](["El último en entrar es el primero en salir", "El primero en entrar es el primero en salir", "Casillas numeradas de acceso directo", "Nodos unidos por punteros"])

[sub_resource type="Resource" id="Resource_cable_09"]
script = ExtResource("2_board")
id = 9
