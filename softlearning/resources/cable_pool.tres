[gd_resource type="Resource" script_class="CablePool" format=3]

[ext_resource type="Script" path="res://core/cable_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://core/db/models/cable_board.gd" id="2_board"]

[sub_resource type="Resource" id="Resource_cable_01"]
script = ExtResource("2_board")
id = 1
department = 0
difficulty = 0
