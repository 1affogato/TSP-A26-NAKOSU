[resource]
script = ExtResource("1_lcgc5")
id = 19
title = "Arreglos dinámicos"
description = "Un arreglo dinámico duplica su capacidad cada vez que se llena. ¿Cuál es el costo amortizado de agregar un elemento al final?"
responses = Array[String](["O(n) amortizado, porque a veces copia todo", "O(log n) amortizado, por las duplicaciones", "O(1) amortizado", "O(n²) amortizado, por las copias acumuladas"])
correct_response_index = 2
difficulty = 3
