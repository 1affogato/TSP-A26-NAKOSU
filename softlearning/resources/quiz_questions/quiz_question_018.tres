[gd_resource type="Resource" script_class="QuizQuestion" format=3]

[ext_resource type="Script" path="res://core/db/models/quiz_question.gd" id="1_qiekv"]

[resource]
script = ExtResource("1_qiekv")
id = 18
title = "Recursión"
description = "¿Qué complejidad tiene calcular fibonacci(n) con la recursión ingenua fib(n) = fib(n-1) + fib(n-2), sin memoización?"
responses = Array[String](["Exponencial, aproximadamente O(2^n)", "Lineal, O(n)", "Cuadrática, O(n²)", "Logarítmica, O(log n)"])
difficulty = 3
