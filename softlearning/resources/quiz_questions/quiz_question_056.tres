[gd_resource type="Resource" script_class="QuizQuestion" format=3]

[ext_resource type="Script" path="res://core/db/models/quiz_question.gd" id="1_s5tls"]

[resource]
script = ExtResource("1_s5tls")
id = 56
department = 3
title = "Principios SOLID"
description = "En el juego, SessionOrchestrator solo conoce la clase abstracta Minigame, y agregar un minijuego nuevo no obliga a modificarlo. ¿Qué dos principios describen directamente esta situación?"
responses = Array[String](["Inversión de dependencias (DIP) y abierto/cerrado (OCP)", "Responsabilidad única (SRP) y segregación de interfaces (ISP)", "Sustitución de Liskov (LSP) y responsabilidad única (SRP)", "Segregación de interfaces (ISP) y abierto/cerrado (OCP)"])
difficulty = 3
