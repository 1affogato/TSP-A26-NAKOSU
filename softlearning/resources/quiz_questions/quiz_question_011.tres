[ext_resource type="Script" path="res://core/db/models/quiz_question.gd" id="1_ptw2y"]

[resource]
script = ExtResource("1_ptw2y")
id = 11
title = "Búsqueda"
description = "La búsqueda binaria descarta la mitad de los elementos en cada paso. ¿Cuántos pasos necesita, aproximadamente, en el peor caso sobre un arreglo ordenado de 1 000 000 de elementos?"
