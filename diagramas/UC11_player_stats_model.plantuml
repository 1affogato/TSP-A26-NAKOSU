@startuml UC11_player_stats_model

skinparam classAttributeIconSize 0

enum Department {
    DATA_STRUCTURES
    REQUIREMENTS
    SOFTWARE_DEV
    CODING_PARADIG
}

class PlayerProfile {
    - id: String
    - username: String
    - companyLevel: int
    - totalPlayTimeSeconds: long
    - lastLogin: Date
    + getDepartmentStats(dept: Department): DepartmentStats
}

class DepartmentStats {
    - id: String
    - department: Department
    - currentLevel: int
    - experiencePoints: int
    - totalGamesPlayed: int
    - totalGamesWon: int
    + getWinRate(): float
    + getMinigameStats(): List<MinigameStats>
}

class MinigameStats {
    - id: String
    - minigameId: String
    - minigameName: String
    - gamesPlayed: int
    - gamesWon: int
    - gamesLost: int
    - highestScore: int
    - currentElo: int
    - totalTimePlayedSeconds: long
    + calculateWinRate(): float
    + recordGameResult(won: boolean, score: int, durationSeconds: long): void
}

PlayerProfile "1" *-- "4" DepartmentStats : tracks >
DepartmentStats "1" *-- "1..*" MinigameStats : contains >
DepartmentStats "1" --> "1" Department : belongsTo >

@enduml