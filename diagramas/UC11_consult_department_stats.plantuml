@startuml UC11_consult_department_stats

actor "Player" as Player
participant "System" as System

Player -> System : selectDepartment(department)
activate System

System -> System : retrieveStats(department)
System --> Player : displayGeneralStats(stats)

opt Department meets upgrade requirements [UC-11.3.a1]
    System --> Player : showUpgradeAvailableNotification()
    Player -> System : initiateUpgrade() [UC-12]
end

deactivate System

@enduml